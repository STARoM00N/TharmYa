# ─── การใช้งาน ─────────────────────────────────────────────────────
# 1. คัดลอกไฟล์นี้เป็น .env:
#      Windows (PowerShell): Copy-Item .env.example .env
#      macOS/Linux:          cp .env.example .env
#
# 2. เปิด .env แก้ค่าใต้บรรทัดที่ต้องการ
#
# 3. app.py และ validation.py โหลด .env อัตโนมัติผ่าน python-dotenv
#    ไม่ต้อง export / set $env:VAR เอง
#
# ⚠️ .env ของจริงถูก .gitignore แล้ว — อย่า commit ไฟล์นี้ที่มี key จริง

# ─── เลือก provider ────────────────────────────────────────────────
# ค่า: gemini | openai (ถ้าไม่ตั้งจะ auto-detect จาก key ที่มี)
AI_PROVIDER=gemini

# ─── Gemini ────────────────────────────────────────────────────────
# ขอ key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── OpenAI / OpenAI-compatible ───────────────────────────────────
# ใช้กับ OpenAI โดยตรง:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#
# ใช้กับ Groq (free tier ใหญ่):
#   OPENAI_API_KEY=gsk_...                                  # console.groq.com/keys
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#
# ใช้กับ OpenRouter:
#   OPENAI_API_KEY=sk-or-...                                # openrouter.ai/keys
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ─── Tuning ───────────────────────────────────────────────────────
# วินาทีที่หน่วงระหว่างเรียก LLM ตอน validation (กัน rate limit)
VALIDATION_SLEEP=5

# Logging level สำหรับ app (DEBUG | INFO | WARNING | ERROR)
PHARMATHAI_LOG_LEVEL=INFO
