      "warnings": [
        "ห้ามเกินขนาด — อาจทำให้ตับวาย",
        "อย่าใช้ร่วมกับยาที่มี paracetamol อยู่แล้ว (เช่น ยาหวัดสูตรผสม)",
        "ระวังในผู้ป่วยโรคตับและไตเรื้อรัง"
      ],
      "should_see_doctor_if": [
        "ไข้สูงเกิน 39°C นานกว่า 3 วัน",
        "ปวดหัวรุนแรงผิดปกติหรือเกิดขึ้นทันที",
        "ไม่ดีขึ้นหลังกิน 2–3 วัน",
        "มีผื่นหรืออาการแพ้"
      ],
      "otc_available": true,
      "price_range_thb": "10–50"
