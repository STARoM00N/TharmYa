        "ปวดหัว",
        "ไข้",
        "ปวดกล้ามเนื้อ",
        "ปวดฟัน",
        "ปวดประจำเดือน",
        "ตัวร้อน"
      ],
      "dosage": {
        "adult": "500–1000 mg ทุก 4–6 ชั่วโมง ไม่เกิน 4000 mg/วัน",
        "child": "10–15 mg/kg ทุก 4–6 ชั่วโมง"
      },
      "contraindications": [
        "โรคตับ",
        "ดื่มแอลกอฮอล์หนัก",
